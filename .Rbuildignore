^.*\.Rproj$           # Ignore RStudio project files
^\.Rproj\.user$       # Ignore RStudio user settings
^\.git$               # Ignore Git version control folder
^\.gitignore$         # Ignore Git ignore file
^_pkgdown\.yml$       # Ignore pkgdown config
^README\.Rmd$         # Ignore README source file
^README\.html$        # Ignore generated README.html
^docs$                # Ignore docs folder
^\.DS_Store$          # Ignore macOS system files
^vignettes/.*\.Rmd$   # Ignore vignette source files (if not needed)
^tests/testthat$      # Ignore testthat folder (if not needed)

